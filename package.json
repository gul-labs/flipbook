{
  "name": "flipbook",
  "private": true,
  "type": "module",
  "description": "Realistic page-flip libraries for the web — vanilla TypeScript core and React wrapper.",
  "license": "MIT AND MPL-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/flipbook.git"
  },
  "homepage": "https://github.com/gul-labs/flipbook",
  "bugs": {
    "url": "https://github.com/gul-labs/flipbook/issues"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "build": "pnpm -r --filter './packages/*' build",
    "build:examples": "pnpm --filter example-vanilla build && pnpm --filter example-vite-react build && pnpm --filter example-nextjs build && pnpm --filter example-mobile-reader build",
    "build:all": "pnpm build && pnpm build:examples",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "typecheck:all": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preflight": "node ./scripts/quality.mjs",
    "quality": "pnpm preflight && pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "check:workflows": "node ./scripts/check-workflow-guards.mjs",
    "quality:ci": "pnpm check:workflows && pnpm test:audit-gate && pnpm preflight && pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm test:coverage-areas && pnpm size && node ./scripts/check-isolated-types.mjs && pnpm test:packed",
    "quality:examples": "pnpm build && pnpm build:examples",
    "quality:full": "pnpm quality:ci && pnpm quality:examples && pnpm audit --audit-level=high",
    "size": "pnpm --filter @gullabs/flipbook-core size",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "test:e2e:golden": "playwright test e2e/golden-flip.spec.ts",
    "test:e2e:golden:update": "playwright test e2e/golden-flip.spec.ts --update-snapshots",
    "test:coverage-areas": "node ./scripts/check-coverage-areas.mjs",
    "test:packed": "node ./scripts/check-packed-artifacts.mjs",
    "test:e2e:golden:update:linux": "bash ./scripts/update-golden-linux.sh",
    "audit:gate": "node scripts/audit.mjs --prod --audit-level=high",
    "test:audit-gate": "node scripts/audit.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
